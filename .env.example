# ============================================================================
# Supabase — set these values in your Vercel project env vars for production.
# Locally, copy this file to `.env` (gitignored) and fill in real values.
# `vercel dev` reads the `.env` file at the project root.
# NEVER commit real keys. The service role key bypasses RLS — guard it.
# ============================================================================

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
# IMPORTANT: do NOT append /rest/v1/ or /auth/v1/ — the supabase-js client
# adds those paths itself. A URL ending in /rest/v1/ breaks every API call.
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe for the browser; RLS still applies).
SUPABASE_ANON_KEY=your-anon-public-key

# Service role key (server-only; FULL database access, bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin allowlist (optional but recommended). When set, only this email address
# may access the admin inbox endpoints (/api/enquiries, etc.). Leave unset to
# allow any valid Supabase user (previous behaviour).
ADMIN_EMAIL=your-admin-email@example.com

# ============================================================================
# hCaptcha — OPTIONAL. Verification is opt-in: the API only verifies a token
# when the contact form actually sends `hcaptcha_token`. The form does not
# render the widget yet, so these are not required but may be stored for when
# captcha is enabled. Get keys at https://www.hcaptcha.com
# ============================================================================

# hCaptcha site key (public; used in the frontend form when the widget is added)
HCAPTCHA_SITEKEY=your-hcaptcha-sitekey

# hCaptcha secret key (server-only; used to verify tokens in API)
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret

# ============================================================================
# FormSubmit — the contact form emails the studio DIRECTLY from the browser
# (see the hardcoded address in contact.html: formsubmit.co/ajax/<address>),
# so no FORM_SUBMIT_EMAIL variable is needed server-side. No API key is
# required, but the FIRST submission to a new address requires confirming the
# activation email FormSubmit sends to that inbox. Docs: https://formsubmit.co
# ============================================================================

# ============================================================================
# Setup checklist:
#  1. Create a Supabase project at https://supabase.com.
#  2. Run supabase/migrations/0001_init.sql, then
#     supabase/migrations/0002_service_role_auth.sql in the SQL editor.
#  3. Dashboard → Authentication → Users → "Add user" → create the admin
#     account (email + password) used by /api/auth/login.
#  4. Copy this file to .env locally and fill in the keys.
#  5. In Vercel: Project Settings → Environment Variables → add the same
#     three vars (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY)
#     for both Production and Preview. Without them every /api/* function
#     fails to boot and the admin login shows a server connection error.
#  6. Deploy.
# ============================================================================
