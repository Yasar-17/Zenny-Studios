# ============================================================================
# Supabase — set these values in your Vercel project env vars for production.
# Locally, copy this file to `.env.local` (gitignored) and fill in real values.
# NEVER commit real keys. The service role key bypasses RLS — guard it.
# ============================================================================

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe for the browser; RLS still applies).
SUPABASE_ANON_KEY=your-anon-public-key

# Service role key (server-only; FULL database access, bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# Setup checklist:
#  1. Create a Supabase project at https://supabase.com.
#  2. Run supabase/migrations/0001_init.sql in the Supabase SQL editor.
#  3. Dashboard → Authentication → Users → "Add user" → create the admin
#     account (email + password) used by /api/auth/login.
#  4. Copy this file to .env.local locally and fill in the keys.
#  5. In Vercel: Project Settings → Environment Variables → add the same
#     three vars (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY).
#  6. Deploy.
# ============================================================================