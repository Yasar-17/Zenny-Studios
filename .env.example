# ============================================================================
# Supabase — set these values in your Vercel project env vars for production.
# Locally, copy this file to `.env` (gitignored) and fill in real values.
# `vercel dev` reads the `.env` file at the project root.
# NEVER commit real keys. The service role key bypasses RLS — guard it.
# ============================================================================

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe for the browser; RLS still applies).
SUPABASE_ANON_KEY=your-anon-public-key

# Service role key (server-only; FULL database access, bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# hCaptcha — optional but recommended for the contact form.
# Get keys at https://www.hcaptcha.com
# ============================================================================

# hCaptcha site key (public; used in the frontend form)
HCAPTCHA_SITEKEY=your-hcaptcha-sitekey

# hCaptcha secret key (server-only; used to verify tokens in API)
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret

# ============================================================================
# FormSubmit — optional email notification on every new enquiry.
# Set this to the studio inbox that should receive enquiry alerts. No API key
# needed, but the first submission will require confirming the address via the
# activation email FormSubmit sends. Leave empty to disable notifications.
# Docs: https://formsubmit.co
# ============================================================================

# Email address that receives a notification for each new enquiry.
FORM_SUBMIT_EMAIL=hello@yourstudio.com

# ============================================================================
# Setup checklist:
#  1. Create a Supabase project at https://supabase.com.
#  2. Run supabase/migrations/0001_init.sql in the Supabase SQL editor.
#  3. Dashboard → Authentication → Users → "Add user" → create the admin
#     account (email + password) used by /api/auth/login.
#  4. Copy this file to .env locally and fill in the keys.
#  5. In Vercel: Project Settings → Environment Variables → add the same
#     three vars (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY).
#  6. Deploy.
# ============================================================================